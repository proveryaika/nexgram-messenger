{
  "expo": {
    "name": "NexGram",
    "slug": "nexgram",
    "scheme": "nexgram",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/nexgram-messenger"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nexgram.messenger"
    },
    "android": {
      "package": "com.nexgram.messenger"
    }
  }
}
